static var route_parts:Dictionary={}
func parts(file:String,trim:bool)->Array[Texture2D]:
 var key=file+str(trim)
 if route_parts.has(key):return route_parts[key]
 if not CROPS.has(file):return super.parts(file,trim)
 var result:Array[Texture2D]=[]
 for i in 4:
  var box=CROPS[file].trim[i]
  var cell=CROPS[file].cell
  var geometry=PlaceholderTexture2D.new()
  geometry.size=Vector2(box[2],box[3]) if trim else Vector2(cell[0],cell[1])
  result.append(geometry)
 route_parts[key]=result
 return result
