extends "res://qingxi-live/village-center/flat-build/trial.gd"
## Build collision and placement from the same scene model in an offscreen viewport.
## This temporary view never consumes a scene handoff, handles input or saves player position.
var edit_map="ranch"
func _ready():
 testing=true
 set_meta("route_geometry",true)
 open_meadow=true
 set_meta("open_meadow",true)
 process_mode=Node.PROCESS_MODE_DISABLED
 if use_fixed_village:
  herd_ai=PastureAI.new(self);load_fixed_village();return
 layout=preload("res://qingxi-live/village-center/layout.gd").new()
 load_assets()
 structures=parts("farm-structures.png",true)
 husbandry=parts("husbandry.png",true)
 room_piece=0
 rooms=Rooms.new(self)
 room_piece=-1
 villagers=preload("res://qingxi-live/village-center/neighbors.gd").new(self) if edit_map in ["ranch","village"] else Villagers.new(self)
 herd_ai=PastureAI.new(self)
 MAP_NAMES.ranch="自家农场"
 build_map(edit_map)

func update_hud():pass
func refresh_life():pass
func fade_in():pass
func notify(_message:String):pass
func save_progress():pass

const HOUSE_CROPS = [[21, 67, 474, 392], [13, 74, 494, 379], [21, 89, 469, 375], [73, 72, 375, 378], [81, 68, 344, 397], [31, 100, 431, 348]]
var room_piece=-1
func trim_image(img:Image)->Image:
 if room_piece<0 or room_piece>=HOUSE_CROPS.size():return super.trim_image(img)
 var box=HOUSE_CROPS[room_piece]
 room_piece+=1
 return img.get_region(Rect2i(box[0],box[1],box[2],box[3]))

